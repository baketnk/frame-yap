{
  "controller_type": "frame_controller",
  "description": "Right X: hold to dictate. B: cancel. A: insert + space. Y: quick chat. Left grip double-tap: submit.",
  "name": "FrameYap Steam Frame controls",
  "bindings": {
    "/actions/frameyap": {
      "sources": [
        {
          "path": "/user/hand/left/input/grip",
          "mode": "button",
          "inputs": { "click": { "output": "/actions/frameyap/in/left_grip" } }
        },
        {
          "path": "/user/hand/right/input/grip",
          "mode": "button",
          "inputs": { "click": { "output": "/actions/frameyap/in/right_grip" } }
        },
        {
          "path": "/user/hand/right/input/x",
          "mode": "button",
          "inputs": { "click": { "output": "/actions/frameyap/in/ptt" } }
        },
        {
          "path": "/user/hand/right/input/b",
          "mode": "button",
          "inputs": { "click": { "output": "/actions/frameyap/in/cancel" } }
        },
        {
          "path": "/user/hand/right/input/a",
          "mode": "button",
          "inputs": { "click": { "output": "/actions/frameyap/in/insert" } }
        },
        {
          "path": "/user/hand/right/input/y",
          "mode": "button",
          "inputs": { "click": { "output": "/actions/frameyap/in/quick_chat" } }
        }
      ]
    }
  }
}
