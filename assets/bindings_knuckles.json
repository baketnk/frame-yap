{
  "controller_type": "knuckles",
  "description": "Example Index controller grip taps; other actions require user rebinding",
  "name": "FrameYap sample grip bindings",
  "bindings": {
    "/actions/frameyap": {
      "sources": [
        {
          "path": "/user/hand/left/input/grip",
          "mode": "button",
          "inputs": { "click": { "output": "/actions/frameyap/in/left_grip" } }
        },
        {
          "path": "/user/hand/right/input/grip",
          "mode": "button",
          "inputs": { "click": { "output": "/actions/frameyap/in/right_grip" } }
        }
      ]
    }
  }
}
